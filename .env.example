# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend Supabase Config (Safe to expose to browser via VITE_ prefix)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend Supabase Config (Server-side only — NEVER prefix with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Single Principal Admin Bootstrap Credentials (Optional; if omitted, first-run setup UI claims the single admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
